---
import "../styles/base.css";
import "../styles/nav.css";
import "../styles/images.css";
import "../styles/contact.css";

import About from "../components/index/About.astro";
import Contact from "../components/index/Contact.astro";
import Hero from "../components/index/Hero.astro";
import Images from "../components/index/Images.astro";
import Nav from "../components/index/Nav.astro";
import PageHead from "../components/shared/PageHead.astro";
import { getImage } from "../config/imageRegistry.js";

const socialImage = await getImage("about_image");
---

<!doctype html>
<html lang="en">
  <head>
    <PageHead
      title="Scuares — Images of Unbuilt Architecture"
      description="Scuares is an architectural image studio creating images of unbuilt architecture for architecture studios worldwide."
      canonical="https://scuares.com/"
      image={socialImage.src}
    />

    <script>
      import "../js/appIndex.js";
    </script>
  </head>

  <body>
    <Nav />
    <main id="page-content">
      <Hero />
      <About />
      <Images />
      <Contact />
    </main>
    <Contact variant="modal" />
  </body>
</html>
