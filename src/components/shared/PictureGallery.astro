---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import {
  GALLERY_SIZES,
  PICTURE_FALLBACK_FORMAT,
  PICTURE_FORMATS,
  PICTURE_QUALITY,
  PICTURE_WIDTHS,
} from "../../config/pictures.js";
import { resolveImage } from "../../config/imageRegistry.js";
import {
  SINGLE_COLUMN_CONDITIONS,
  ULTRA_WIDE_QUERY,
} from "../../styles/breakpoints.js";

interface Props {
  src: string | ImageMetadata;
  alt: string;
  class?: string;
  loading?: "eager" | "lazy";
  decoding?: "async" | "auto" | "sync";
  fetchpriority?: "high" | "low" | "auto";
  priority?: boolean;
  size?: "normal" | "full-one" | "full-two" | "full-cover";
  pictureAttributes?: Record<string, unknown>;
}

const {
  src: source,
  alt,
  class: className,
  loading = "lazy",
  decoding = "async",
  fetchpriority,
  priority,
  size = "normal",
  pictureAttributes,
} = Astro.props;

const src = await resolveImage(source);
const ratio = src.width / src.height;
let sizes = GALLERY_SIZES;

if (size !== "normal") {
  const width = size === "full-two" ? 50 : 100;
  let singleColumn = "100vw";
  let desktop = `max(${width}vw, ${100 * ratio}vh)`;
  let ultrawide = `max(${width}vw, ${50 * ratio}vw)`;

  if (size === "full-cover") {
    // Match base.css at its 10px root font (html: 62.5%): --cover-column
    // is 40rem and --frame-x/y are 1.6rem per side. Text padding is already
    // inside the column's border box. Keep these in sync with the cover CSS.
    const textColumnPx = 400;
    const frameTotalPx = 32;
    const imageWidth = `100vw - ${textColumnPx + frameTotalPx}px`;
    desktop = `max(${imageWidth}, ${100 * ratio}vh - ${frameTotalPx * ratio}px)`;
    ultrawide = `max(${imageWidth}, ${50 * ratio}vw - ${frameTotalPx * ratio}px)`;
    // Mobile covers have no padding and stay 100vw square. Using the whole
    // square conservatively allows for the in-flow credit reducing image height.
    singleColumn = `max(100vw, ${100 * ratio}vw)`;
  }

  // Single-column rules override ultrawide in CSS. Each condition needs its
  // own sizes entry; only slide images become uncropped in this layout.
  sizes = [
    ...SINGLE_COLUMN_CONDITIONS.map((condition) => `${condition} ${singleColumn}`),
    `${ULTRA_WIDE_QUERY} ${ultrawide}`,
    desktop,
  ].join(", ");
}
---

<Picture
  src={src}
  alt={alt}
  class={className}
  data-gallery-image=""
  formats={PICTURE_FORMATS}
  fallbackFormat={PICTURE_FALLBACK_FORMAT}
  widths={PICTURE_WIDTHS}
  sizes={sizes}
  quality={PICTURE_QUALITY}
  loading={loading}
  decoding={decoding}
  fetchpriority={fetchpriority}
  priority={priority}
  pictureAttributes={{
    ...pictureAttributes,
    "data-gallery-picture": "",
  }}
/>
