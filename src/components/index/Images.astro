---
import Credit from "../shared/Credit.astro";
import PictureGallery from "../shared/PictureGallery.astro";
---

<!--==============================
  IMAGES
 ==============================-->
 
<!-- wolf garden crop / walkeweg -->
<section class="images-two snap" data-logo="light" data-contact="dark">
  <div class="img-full align-bottom">
    <PictureGallery
      src="wolf_garden_crop"
      alt="3D rendering of planted apartment balconies above a communal garden and exterior stairs"
    />
    <Credit
      author="[1st PRIZE] Parabase"
      project="Binaria SBB Wolf MF03"
    />
  </div>
  <div class="img-pad">
    <PictureGallery
      src="walkeweg_a"
      alt="3D rendering of timber-clad homes and gardens beside the railway at Walkeweg Nord"
    />
    <Credit
      author="[1st PRIZE] Parabase"
      project="Areal Walkeweg Nord Basel"
    />
  </div>
</section>

<!-- walkeweg_b / maloja_street_crop -->

<section class="images-two snap" data-logo="dark" data-contact="light">
  <div class="img-pad">
    <PictureGallery
      src="walkeweg_b"
