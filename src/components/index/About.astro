---
import Credit from "../shared/Credit.astro";
import PictureGallery from "../shared/PictureGallery.astro";
---

<!--==============================
  ABOUT
 ==============================-->
<section
  class="images-two snap nav-dock-section"
  data-logo="dark"
  data-contact="light"
  id="about"
>
  <div class="centered-box">
    <div class="text-box">
      <h1 class="text-normal">
        Images of<br />
        unbuilt<br />
        architecture
      </h1>
      <p class="text-normal">
        <br />

        Scuares is an architectural<br />
        image studio founded in Barcelona<br />
        by architect Josep Alcover,<br />
        making photographic stills for<br />
        competitions, design development<br />
        and publication.<br />
        <br />
        <br />
        <!-- 
        *<br />
        real estate, hospitality<br />
        and commercial visuals<br />
        <a
          class="about-service-link"
          href="/commercial"
          aria-label="Visit Scuares Commercial">scuares / commercial →</a
        >
          -->
      </p>
    </div>
  </div>

  <div class="img-full">
    <PictureGallery
      src="llamp_front"
      alt="3D rendering of a terraced modern house surrounded by Mediterranean planting"
    />
    <Credit 
      author="Isla Architects" 
      project="House in Cala Llamp" />
  </div>
</section>
