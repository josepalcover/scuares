---
import PictureHero from "../shared/PictureHero.astro";
---

<!--==============================
  HERO - HOME
 ==============================-->
<section
  class="hero-full snap"
  data-logo="dark"
  data-contact="dark"
  data-scroll-target="#about"
  data-hero-sequence
  data-hero-interval="3000"
  id="home"
>
  <div class="logo-hero" data-hero-logo>scuares</div>
  <div class="img-hero">
    <!--FIRST IMAGE -->
    <PictureHero
      src="cover_wolf_garden"
      alt="3D rendering of planted terraces and exterior stairs at the Binaria SBB Wolf housing complex"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      pictureAttributes={{
        "data-hero-current": "",
        "data-logo": "light",
      }}
    />

  <!--REPEAT THE FIRST IMAGE HERE -->
    <template data-hero-slides>
        <PictureHero
        src="cover_wolf_garden"
        alt="3D rendering of planted terraces and exterior stairs at the Binaria SBB Wolf housing complex"
        pictureAttributes={{
          "data-hero-slide": "",
          "data-logo": "light",
        }}
      />
      <PictureHero
        src="cover_vidy"
        alt="Low-angle 3D rendering of green sunshades wrapping the Service de l’eau building in Vidy"
        pictureAttributes={{
          "data-hero-slide": "",
          "data-logo": "light",
        }}
      />
      <PictureHero
        src="cover_wolf_street"
        alt="Street-level 3D rendering of the Binaria SBB Wolf façade with a circular entrance"
        pictureAttributes={{
          "data-hero-slide": "",
          "data-logo": "light",
        }}
      />
      <PictureHero
        src="cover_basel"
        alt="3D rendering of the Burgfelderstrasse housing block behind a landscaped courtyard"
        pictureAttributes={{
          "data-hero-slide": "",
          "data-logo": "light",
        }}
      />
      
    </template>
  </div>
</section>
