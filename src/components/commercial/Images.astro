---
import Credit from "../shared/Credit.astro";
import PictureGallery from "../shared/PictureGallery.astro";
---

<!--==============================
  IMAGES
===============================-->
<div class="section" id="images">
  <section class="images cover snap">
    <div class="cover-text">
      <h2 class="header-sub">IMAGES</h2>
      <h3 class="header-main">
        We make the unbuilt<br />
        look real.<br />
      </h3>
      <p class="text-1">
        Our photorealistic 3D images present your project as if it was already
        built. Each image is composed to communicate its architecture,
        atmosphere and value.
      </p>
    </div>
    <div class="cover-content">
      <div class="img-full align-bottom">
        <PictureGallery
          src="campbell"
          alt="Photorealistic exterior 3D Rendering of a wooden sports complex designed by Transversal Architects and Acte architects. Contemporary facade design. Still CG Image produced by Scuares, an architectural visualization studio"
        />
        <Credit
          author="Transversal + Acte Arch."
          project="Sports Complex in St. Maurice"
        />
      </div>
    </div>
  </section>

  <section class="images-one snap">
    <div class="img-pad">
      <PictureGallery
        src="llamp_living_com"
        alt="3D rendering of an open-plan living and dining room with panoramic Mediterranean views"
