---
import PictureHero from "../shared/PictureHero.astro";
---

<!--====================
  HOME
========================-->
<header>
  <section class="home section snap" id="home" data-scroll-target="#films">
    <div class="cover-content" data-hero-sequence data-hero-interval="3000">
      <div class="img-hero">
        <PictureHero
          src="walkeweg_b"
          alt="Photorealistic architectural visualization by Scuares"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          pictureAttributes={{
            "data-hero-current": "",
            "data-logo": "light",
          }}
        />

        <template data-hero-slides>
          <PictureHero
            src="walkeweg_b"
            alt="Photorealistic architectural visualization by Scuares"
            pictureAttributes={{
              "data-hero-slide": "",
              "data-logo": "light",
            }}
          />
          <PictureHero
            src="puglia"
            alt="Photorealistic architectural visualization by Scuares"
            pictureAttributes={{
              "data-hero-slide": "",
              "data-logo": "dark",
            }}
          />
          <PictureHero
            src="walkeweg_a"
            alt="Photorealistic architectural visualization by Scuares"
            pictureAttributes={{
              "data-hero-slide": "",
              "data-logo": "light",
            }}
          />
          <PictureHero
            src="basel_b"
            alt="Photorealistic architectural visualization by Scuares"
            pictureAttributes={{
              "data-hero-slide": "",
              "data-logo": "light",
            }}
          />
          <PictureHero
            src="basel_a"
            alt="Photorealistic architectural visualization by Scuares"
            pictureAttributes={{
              "data-hero-slide": "",
              "data-logo": "light",
            }}
          />
        </template>
      </div>
    </div>

    <div class="cover-text">
      <h1 class="header-main">
        <span class="header-sub">3D RENDERINGS</span><br />
        Architectural<br />
        Visualization<br />
      </h1>
      <p class="text-1">
        Scuares makes images, films and 360° virtual tours for real estate,
        hospitality and commercial projects.
      </p>
      <nav class="hero-service-links" aria-label="Commercial services">
        <a
          class="hero-service-link"
          href="#images"
          aria-label="Scroll to the images section">Images →</a
        >
        <a
          class="hero-service-link"
          href="#films"
          aria-label="Scroll to the films section">Films →</a
        >
        <a
          class="hero-service-link"
          href="#tours"
          aria-label="Scroll to the tours section">Tours →</a
        >
      </nav>
    </div>
  </section>
</header>
